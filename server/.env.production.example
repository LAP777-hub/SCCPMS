# Copy into your deployment secret store. Do not commit credentials.
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
FRONTEND_ORIGIN=https://clinic.your-domain.com

# PostgreSQL and the Supabase API must point to the SAME project.
DATABASE_URL=postgresql://user:password@your-supabase-pooler:6543/postgres
DATABASE_SSL_MODE=verify-full
# Optional custom CA, encoded with literal \n between lines; the Supabase CA is bundled:
# DATABASE_SSL_CA=
# Local/container LISTEN needs a session connection. Vercel uses only DATABASE_URL.
# DATABASE_EVENTS_URL=postgresql://user:password@your-supabase-pooler:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-project-service-role-key
OTP_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_VALIDITY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30

# Store the full Resend API key in hosting secrets, not a masked CSV export.
RESEND_API_KEY=re_replace_with_full_resend_api_key
# This mailbox's custom domain must be verified and enabled for sending in Resend.
# Production refuses the onboarding@resend.dev test sender.
RESEND_FROM_EMAIL="SCCPMS <clinic@your-verified-domain.com>"
# Read-only domain check: npm run email:check --prefix server -- --production

# Configure invitation/confirmation SMTP and redirect URLs in Supabase Auth.
# Browser configuration belongs in the project root, using public keys only.
