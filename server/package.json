{
  "name": "sccpms-api",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "auth:sync-claims": "tsx scripts/sync-account-claims.ts",
    "auth:check-redirects": "node scripts/auth-redirect-settings.mjs",
    "auth:configure-redirects": "node scripts/auth-redirect-settings.mjs --apply",
    "auth:configure-email": "node scripts/configure-auth-email.mjs",
    "connections:check": "node scripts/check-connections.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:database": "node --import tsx tests/run-database-tests.ts",
    "test:coverage": "tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "security:audit": "node ../scripts/security-audit.js",
    "env:validate": "node ../scripts/validate-env.js",
    "email:check": "node scripts/check-email.mjs",
    "email:prepare-university": "node scripts/prepare-university-email.mjs",
    "sms:check": "node scripts/check-sms.mjs",
    "sms:configure": "node scripts/configure-sms.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/functions": "^3.9.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "prettier": "^3.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
