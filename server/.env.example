NODE_ENV=development
PORT=4000
TRUST_PROXY=0
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@localhost:5432/sccpms
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional management credential used only by auth:configure-redirects, never by the app.
# Keep a real token only in ignored .env; application keys cannot change hosted Auth settings.
SUPABASE_ACCESS_TOKEN=
OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
# Countdown starts only after provider acceptance; failed sends do not shorten it.
OTP_VALIDITY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
# Resend sends login OTPs ONLY for the exact configured owner administrator.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Keep both bindings; a primary sender never enables Resend for other users.
RESEND_ADMIN_OWNER_EMAIL=
RESEND_ADMIN_OWNER_USER_ID=
# Brevo API sends login OTPs for patients, doctors and receptionists.
# Apply migration026 before enabling a sender on an existing Resend installation.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Administrative Supabase SMTP configuration only; the runtime API needs neither.
# Use the SMTP username displayed by Brevo, not an assumed account email.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
# Read-only sender/relay/SMTP inspection:
# npm run auth:configure-brevo --prefix server -- --inspect

# All valid recipient email domains are accepted.

# OSM address autocomplete: limited public Photon demo for initial evaluation.
# For university deployment, configure a dedicated/self-hosted Photon /api/ endpoint.
ADDRESS_PHOTON_URL=https://photon.komoot.io/api/
# Cached searches are excluded; Vercel shares the provider budget in PostgreSQL.
ADDRESS_SEARCH_INTERVAL_MS=1100
ADDRESS_SEARCH_DAILY_LIMIT=500
